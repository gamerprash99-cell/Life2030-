# Copy this file to keystore.properties and fill in real values to enable
# release signing (gradle assembleRelease). If the file is absent, release
# builds fall back to debug signing so CI stays green — but a real APK
# should always ship from a signed release keystore.
#
# Keep keystore.properties and your .jks/.keystore OUT of version control
# (both are gitignored). Guard the keystore file and here hard.
storeFile=/absolute/path/to/lifeos-release.jks
storePassword=CHANGE_ME
keyAlias=lifeos
keyPassword=CHANGE_ME