<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Rule #22 from the LifeOS spec: "Request Android permissions only when required."
        POST_NOTIFICATIONS is declared because Tasks/Habits schedule local reminders,
        and is requested at RUNTIME (see SettingsScreen) — never on first launch.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Requested only when the Diary editor's Add voice action is tapped. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The audible alarm is a foreground service so it keeps ringing even in
         deep Doze / locked / app-in-background (platform permits starting an FGS
         from a setAlarmClock alarm). Type mediaPlayback: no special-access
         criteria to satisfy and it works even when exact alarms are denied. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Full-screen alarms keep the reminder visible above the lock screen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- SCHEDULE_EXACT_ALARM lets LifeOS deliver task/habit reminders at the
         exact scheduled minute. It is a special access the user enables in
         Android's "Alarms & reminders" system page (requested from Settings and
         from the task-reminder gate — never at launch). When it is denied the
         shared scheduler falls back to the permission-free, Doze-aware inexact
         API, so reminders always keep working without ever throwing. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- No INTERNET permission: all LifeOS features run entirely on-device.
         There is no HTTP client, no API key, and no network code anywhere in this app. -->

    <application
        android:name=".LifeOSApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifeOS"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LifeOS.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            Alarm delivery. AlarmReceiver is reached only via the explicit
            PendingIntent created in ReminderScheduler (no intent filter, so it
            can never be triggered by another app). BootReceiver handles the
            system broadcasts that invalidate armed alarms.
        -->
        <receiver
            android:name=".core.reminders.AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".core.reminders.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
            Audible alarm foreground service (see AlarmPlaybackService). The
            sound lives here, never in the full-screen activity, so STOP/snooze
            from any surface can never double-ring.
        -->
        <service
            android:name=".core.reminders.AlarmPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Full-screen alarm (also launched as the notification's FSI). -->
        <activity
            android:name=".core.reminders.AlarmFullScreenActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:theme="@style/Theme.LifeOS"
            tools:targetApi="27" />

    </application>

</manifest>
