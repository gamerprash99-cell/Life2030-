<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Rule #22 from the LifeOS spec: "Request Android permissions only when required."
        POST_NOTIFICATIONS is declared because Tasks/Habits schedule local reminders,
        and is requested at RUNTIME (see SettingsScreen) — never on first launch.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Full-screen alarms keep the reminder visible above the lock screen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- No INTERNET permission: all LifeOS features run entirely on-device.
         There is no HTTP client, no API key, and no network code anywhere in this app. -->
    <!-- No SCHEDULE_EXACT_ALARM: reminders use the permission-free, Doze-aware
         inexact AlarmManager API (setAndAllowWhileIdle), so no exact-alarm
         special access is requested or required. -->

    <application
        android:name=".LifeOSApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifeOS"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LifeOS.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            Alarm delivery. AlarmReceiver is reached only via the explicit
            PendingIntent created in ReminderScheduler (no intent filter, so it
            can never be triggered by another app). BootReceiver handles the
            system broadcasts that invalidate armed alarms.
        -->
        <receiver
            android:name=".core.reminders.AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".core.reminders.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Full-screen alarm (also launched as the notification's FSI). -->
        <activity
            android:name=".core.reminders.AlarmFullScreenActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:theme="@style/Theme.LifeOS"
            tools:targetApi="27" />

    </application>

</manifest>
