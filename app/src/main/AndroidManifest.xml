<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Rule #22 from the LifeOS spec: "Request Android permissions only when required."
        POST_NOTIFICATIONS is declared because Tasks/Habits schedule local reminders,
        and is requested at RUNTIME (see SettingsScreen) — never on first launch.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The audible alarm is a foreground service so it keeps ringing even in
         deep Doze / locked / app-in-background (platform permits starting an FGS
         from a setAlarmClock alarm). Type mediaPlayback: no special-access
         criteria to satisfy and it works even when exact alarms are denied. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Full-screen alarms keep the reminder visible above the lock screen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!--
        Package visibility (API 30+): Settings can only be asked whether it
        handles the notification-listener access intents if LifeOS says it looks
        for them. This declares visibility of the Settings activity alone — no
        other package is declared, and no permission is implied by it.
    -->
    <queries>
        <intent>
            <action android:name="android.settings.NOTIFICATION_LISTENER_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.NOTIFICATION_LISTENER_DETAIL_SETTINGS" />
        </intent>
    </queries>
    <!-- SCHEDULE_EXACT_ALARM lets LifeOS deliver task/habit reminders at the
         exact scheduled minute. It is a special access the user enables in
         Android's "Alarms & reminders" system page (requested from Settings and
         from the task-reminder gate — never at launch). When it is denied the
         shared scheduler falls back to the permission-free, Doze-aware inexact
         API, so reminders always keep working without ever throwing. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Diary voice notes. RECORD_AUDIO is requested at RUNTIME and only when
         the user taps "Add voice note" (see DiaryEditorScreen) — never at
         launch. Recordings are written to app-private storage and never leave
         the device. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Diary location. COARSE is enough for the city/place name shown beside
         an entry; FINE is declared for the precise case and is requested
         together with COARSE, in-app, only when the user taps "Add location".
         Coordinates are resolved to a place name on-device and stored in the
         encrypted local database — never transmitted. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Diary photos are attached through the Android Photo Picker
         (ActivityResultContracts.PickVisualMedia), which grants per-URI access
         with NO storage or media permission. The picked image is then copied
         into app-private storage so it survives the source being deleted.
         CAMERA is deliberately NOT declared: Diary attaches existing photos
         rather than taking new ones, so camera access would be an unnecessary
         permission. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!-- No INTERNET permission: all LifeOS features run entirely on-device.
         There is no HTTP client, no API key, and no network code anywhere in
         this app. This is also why the Diary weather row reports an honest
         "unavailable" state instead of a reading: no permitted weather source
         exists in this build (see WeatherRepository). -->

    <application
        android:name=".LifeOSApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifeOS"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LifeOS.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            Alarm delivery. AlarmReceiver is reached only via the explicit
            PendingIntent created in ReminderScheduler (no intent filter, so it
            can never be triggered by another app). BootReceiver handles the
            system broadcasts that invalidate armed alarms.
        -->
        <receiver
            android:name=".core.reminders.AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".core.reminders.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
            Audible alarm foreground service (see AlarmPlaybackService). The
            sound lives here, never in the full-screen activity, so STOP/snooze
            from any surface can never double-ring.
        -->
        <service
            android:name=".core.reminders.AlarmPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!--
            Payment-notification capture (Phase 1). The platform requires this
            service to be exported so it can be bound by system_server, and
            requires BIND_NOTIFICATION_LISTENER_SERVICE on it; together those
            mean only the platform may bind it, never another app. The feature
            itself stays off until the user grants notification access and turns
            the toggle on in Settings — see TransactionCaptureService.
        -->
        <service
            android:name=".core.transactions.TransactionCaptureService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">

            <!--
                Required, not decorative. Settings builds its list of apps that
                can be granted notification access by querying for services that
                handle this action, so a service without this filter is never
                shown to the user and the grant can never be made from the
                system UI. The permission above is still what stops any other app
                from binding it.
            -->
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Full-screen alarm (also launched as the notification's FSI). -->
        <activity
            android:name=".core.reminders.AlarmFullScreenActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:theme="@style/Theme.LifeOS"
            tools:targetApi="27" />

    </application>

</manifest>
