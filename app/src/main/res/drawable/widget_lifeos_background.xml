<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget card background in the Lavender Dream family. RemoteViews widgets
    are inflated outside the app's Compose theme, so it cannot read LifeOS
    tokens and the colours are literals — the values mirror the dark-polarity
    soft (#463956) and surface (#24202F) tokens.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="315"
        android:startColor="#463956"
        android:endColor="#24202F"
        android:type="linear" />
</shape>
