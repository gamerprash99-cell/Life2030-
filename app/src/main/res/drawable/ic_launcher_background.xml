<?xml version="1.0" encoding="utf-8"?>
<!--
    LifeOS launcher background — the AURA lagoon.

    Previously a flat generic indigo (#6C63FF). It is now the app's own lagoon:
    a deep teal at the top-right falling to near-black plum, so the coral→mint
    ring in the foreground reads as light over water. The mark is unchanged;
    only the colour moved onto the app's real palette.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="1.0"
                android:startY="0.0"
                android:endX="0.10"
                android:endY="1.0">
                <item android:offset="0.0" android:color="#FF16463B" />
                <item android:offset="0.45" android:color="#FF0C1A18" />
                <item android:offset="1.0" android:color="#FF0B0A14" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
