<?xml version="1.0" encoding="utf-8"?>
<!--
    LifeOS launcher background — Lavender Dream night.

    A deep violet at the top-right falling to the dark canvas (#17141F), so
    the lavender ring in the foreground reads as light in a lavender sky.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="1.0"
                android:startY="0.0"
                android:endX="0.10"
                android:endY="1.0">
                <item android:offset="0.0" android:color="#FF463956" />
                <item android:offset="0.45" android:color="#FF24202F" />
                <item android:offset="1.0" android:color="#FF17141F" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
