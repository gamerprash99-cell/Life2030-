<?xml version="1.0" encoding="utf-8"?>
<!--
    Metadata for the "Today" home-screen widget. 30-minute update period is the
    platform minimum; the provider also refreshes on every APPWIDGET_UPDATE so a
    launcher-driven refresh picks up newly logged rows.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_lifeos_today"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_today_description" />
