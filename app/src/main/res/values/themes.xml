<resources>
    <style name="Theme.LifeOS" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!--
            The window behind the first frame. Matched to the LifeOS canvas
            (#FDF8FF) rather than pure white so the hand-off from the splash to
            the composed UI is invisible instead of flashing a brighter white.
        -->
        <item name="android:windowBackground">@color/lifeos_canvas</item>
    </style>

    <!--
        Android 12+ native splash (backported by androidx.core:core-splashscreen
        on older API levels). MainActivity uses this so the system's own startup
        screen covers the encrypted-database open; LifeOS never shows a second,
        custom "Unlocking your data…" screen.

        The background is the canvas colour and the icon is the branded launcher
        mark, so the system splash, the LifeOS brand reveal that follows it
        (ui/startup/BrandReveal.kt) and the app itself are one continuous
        lavender surface. The reveal animates because the database genuinely has
        not opened yet — it is never held on screen to lengthen the splash.
    -->
    <style name="Theme.LifeOS.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/lifeos_canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.LifeOS</item>
    </style>
</resources>
